# Porta do servidor HTTP e Socket.IO
PORT=3000

# Conexão com o PostgreSQL (local ou Neon)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/knucklebones

# Segredo para assinar os tokens JWT (mínimo de 32 caracteres)
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# Endereço do frontend, liberado no CORS
FRONTEND_URL=http://localhost:5173
